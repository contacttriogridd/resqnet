# ─────────────────────────────────────────────────────────────
# RESQNET environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Only variables prefixed with VITE_ are exposed to the browser —
# never put secrets in a VITE_ variable.
# ─────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/resqnet?schema=public
# Separate database used by the backend integration tests (it is wiped on every run)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/resqnet_test?schema=public

# JWT signing secrets — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Simulation/demo endpoints (admin-only). Keep `false` in real deployments.
DEMO_MODE_ENABLED=true

# Initial admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@resqnet.local
SEED_ADMIN_PASSWORD=

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Frontend (public, bundled into the browser app) ──────────
# Base URL of the REST API as seen from the browser. Leave as /api when the
# frontend dev server / reverse proxy forwards /api to the backend.
VITE_API_BASE_URL=/api
# Default region offered for offline download
VITE_DEFAULT_REGION=Coimbatore
