{
  "name": "@resqnet/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "dotenv -e ../.env -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "dotenv -e ../.env -- vitest run",
    "test:watch": "dotenv -e ../.env -- vitest",
    "prisma": "dotenv -e ../.env -- prisma",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../.env -- tsx src/database/seed.ts",
    "db:reset": "dotenv -e ../.env -- prisma migrate reset --force",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "../prisma/schema.prisma",
    "seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "~6.19.0",
    "@resqnet/shared": "1.0.0",
    "argon2": "^0.44.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.13.0",
    "pino-http": "^10.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^10.0.0",
    "pino-pretty": "^13.1.1",
    "prisma": "~6.19.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
