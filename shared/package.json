{
  "name": "@resqnet/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Domain enums, validation schemas and pure business rules shared by the RESQNET frontend and backend",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
